{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo 'Edge functions, no build needed'",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/mint", "destination": "/mint.html" },
    { "source": "/nft/(?<id>[^/]+)", "destination": "/nft.html" }
  ]
}
